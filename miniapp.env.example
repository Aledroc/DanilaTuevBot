# Public HTTPS URL configured in Telegram BotFather and used by /app.
MINIAPP_URL=https://danilatuev.wispbyte.app

# Required when Mini App service runs as a separate process.
TELEGRAM_TOKEN=replace-with-your-bot-token
# Required by the web app if it runs in a separate process from the bot.
MINIAPP_BOT_USERNAME=YourBotUsername
MINIAPP_HOST=0.0.0.0
MINIAPP_PORT=13859
BOT_DATA_DIR=.

# Only for local development without Telegram signature validation.
# Never enable on an internet-facing server.
# MINIAPP_DEV_MODE=1
# MINIAPP_DEV_USER_ID=1
